# OneLogin SSO Configuration for Five9 Examples
# Copy this file to .env and fill in your values

# Your OneLogin subdomain (e.g., "mycompany" from mycompany.onelogin.com)
ONELOGIN_SUBDOMAIN=

# OneLogin API credentials
# Create at: OneLogin Admin > Developers > API Credentials
# Required permissions: "Generate SAML tokens"
ONELOGIN_CLIENT_ID=
ONELOGIN_CLIENT_SECRET=

# Five9 app ID in OneLogin (numeric ID from the app URL)
# Find at: OneLogin Admin > Applications > [Your Five9 App] - check URL for ID
ONELOGIN_FIVE9_APP_ID=

# OneLogin region: "us" (default) or "eu"
ONELOGIN_REGION=us

# Target user for SSO authentication
ONELOGIN_TARGET_USER=
ONELOGIN_TARGET_PASSWORD=
